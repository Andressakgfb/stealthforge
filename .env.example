# CADS Pro — exemplo sem credenciais. Copie para .env apenas no deploy systemd.
# Arquivo compatível com EnvironmentFile do systemd; não use comentários inline.
# Obrigatória: gere com generate_admin_key.ps1/.sh ou openssl rand -hex 32.
# Preencha uma chave real apenas no .env privado, nunca neste exemplo.
ADMIN_API_KEY=

# Limites por IP e minuto. Inteiros positivos; janela compartilhada por categoria.
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_PROCESSING=10
RATE_LIMIT_ADMIN=5

# Referência mensal do painel; não altera o controle diário das chaves de plano.
PLAN_LIMIT_DEFAULT=5000

# critical, error, warning, info ou debug.
LOG_LEVEL=info

# Opcional para deploy: diretório absoluto dos dados graváveis.
# CADS_DATA_DIR=/var/lib/cads-pro
